# Modo mantenimiento: mostrar modal de actualizacion y formulario de notificacion por email.
# Valores: true | false (o sin definir). Se inyecta en build (Vite).
# VITE_EPIX_MAINTENANCE=true

# URL base del CRM para registrar emails ""notificarme cuando este disponible"".
# Debe exponer POST /api/lead. CORS del CRM debe incluir el origen de E-pix.
# VITE_CRM_API_URL=https://tu-crm.ejemplo.com

{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true
    },
    "include": ["src"],
    "exclude": [
        "node_modules",
        "**/node_modules/**",
        "dist",
        "**/dist/**",
        "build",
        "**/build/**",
        "_TO_DELETE_*",
        "**/_TO_DELETE_*/**",
        "coverage",
        ".next",
        ".nuxt",
        ".turbo",
        ".cache",
        "tmp",
        "temp",
        "out",
        "storybook-static",
        "cypress",
        "playwright-report"
    ]
}
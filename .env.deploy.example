# Copiá este archivo a .env.deploy y completá (no subas .env.deploy a git).

HOSTINGER_FTP_HOST=ftp.tudominio.com
HOSTINGER_FTP_USERNAME=tu_usuario_ftp
HOSTINGER_FTP_PASSWORD=tu_contraseña

# Opcional: ftp | ftps | ftps-legacy (en hosting compartido suele ir bien ftp)
HOSTINGER_FTP_PROTOCOL=ftp
HOSTINGER_FTP_PORT=21

# Carpeta en el servidor (vacío o ./ si el FTP ya abre en public_html)
HOSTINGER_FTP_REMOTE_DIR=public_html

# Tras subir, abrir el sitio en el navegador (1 = sí)
OPEN_SITE_AFTER_DEPLOY=1
PUBLIC_SITE_URL=https://alenia.online

# Opcional: abrir hPanel (no sube archivos; solo atajo)
# OPEN_HPANEL_AFTER_DEPLOY=1
# HOSTINGER_HPANEL_URL=https://hpanel.hostinger.com

# Depuración: FTP_VERBOSE=1

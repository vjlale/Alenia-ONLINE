# === Copiá a .env.deploy y completá (nunca subas .env.deploy a git) ===
#
# En Hostinger, si en el administrador de archivos ves la raíz con
# DO_NOT_UPLOAD_HERE y la carpeta public_html, el sitio va DENTRO de public_html.
# Eso coincide con HOSTINGER_FTP_REMOTE_DIR=public_html (valor por defecto abajo).

HOSTINGER_FTP_HOST=ftp.tudominio.com
HOSTINGER_FTP_USERNAME=tu_usuario_ftp
HOSTINGER_FTP_PASSWORD=tu_contraseña

HOSTINGER_FTP_PROTOCOL=ftp
HOSTINGER_FTP_PORT=21

# Raíz FTP con carpeta public_html → public_html
# Si FileZilla ya abre dentro de public_html → ./
HOSTINGER_FTP_REMOTE_DIR=public_html

OPEN_SITE_AFTER_DEPLOY=1
PUBLIC_SITE_URL=https://alenia.online

# OPEN_HPANEL_AFTER_DEPLOY=1
# FTP_VERBOSE=1
